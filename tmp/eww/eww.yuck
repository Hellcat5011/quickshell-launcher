;; --- Variables --- ;;

(defpoll clock_time :interval "1s" "date '+%I:%M'")
(defpoll clock_date :interval "10m" "date '+%A, %B %d'")

(deflisten media_status :initial "" 
  "playerctl metadata --format '{{title}} - {{artist}}' --follow")

(deflisten media_state :initial "" 
  "playerctl status --follow")

(deflisten cover_art :initial "" "~/.config/eww/get_cover.sh")

;; --- Individual Widgets --- ;;

(defwidget clock_module []
  (box :orientation "v" :space-evenly false :class "widget-box"
    (label :text clock_time :class "time-text")
    (label :text clock_date :class "date-text")))

(defwidget calendar_module []
  (box :class "widget-box"
    (calendar)))

(defwidget mpris_module []
  (box :orientation "h" :space-evenly false :class "widget-box" :visible {media_state == "Playing" || media_state == "Paused"}
    
    ;; Album Art
    (box :class "album-art" 
         :style "background-image: url('${cover_art}');" 
         :visible {cover_art != ""})
    
    ;; Text and Controls
    (box :orientation "v" :space-evenly false :spacing 15 :valign "center" :class "mpris-info-box"
      (label :text "${media_status}" :limit-width 30 :wrap true :class "mpris-text")
      
      (box :orientation "h" :space-evenly false :spacing 15 :halign "center" :class "mpris-controls"
        (button :class "mpris-btn" :onclick "playerctl previous" "⏮")
        (button :class "mpris-btn" :onclick "playerctl play-pause" {media_state == "Playing" ? "⏸" : "▶"})
        (button :class "mpris-btn" :onclick "playerctl next" "⏭")))))

(defwidget systray_module []
  (box :orientation "v" :space-evenly false :class "systray-box"
    (systray :orientation "h" :spacing 12 :icon-size 22 :prepend-new true)))

;; --- Independent Windows --- ;;

(defwindow clock
  :monitor 0
  :namespace "clock"
  :stacking "bg"
  :exclusive false
  :focusable false
  :geometry (geometry :x "30px" :y "380px" :width "360px" :anchor "bottom right")
  (clock_module))

(defwindow calendar
  :monitor 0
  :namespace "calendar"
  :stacking "bg"
  :exclusive false
  :focusable false
  :geometry (geometry :x "30px" :y "30px" :anchor "bottom right")
  (calendar_module))

(defwindow mpris
  :monitor 0
  :namespace "mpris"
  :stacking "bg"
  :exclusive false
  :focusable false
  :geometry (geometry :x "30px" :y "30px" :width "400px" :anchor "top right")
  (mpris_module))

(defwindow systray
  :monitor 0
  :namespace "systray"
  :stacking "bg"
  :exclusive false
  :focusable false
  :geometry (geometry :x "30px" :y "180px" :anchor "top right")
  (systray_module))
